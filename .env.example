# Base de datos PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Secretos criptográficos para JWT (generar con openssl rand -base64 32)
JWT_ACCESS_SECRET="tu_jwt_access_secret_super_seguro_min_32_caracteres"
JWT_REFRESH_SECRET="tu_jwt_refresh_secret_super_seguro_min_32_caracteres"

# Duración y expiración de tokens
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"